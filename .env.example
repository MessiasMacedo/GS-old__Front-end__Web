# Copie este arquivo para .env.local e preencha (o .env.local NUNCA vai para o git).
# Supabase > Project Settings > API (ou "API Keys"):
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A chave PÚBLICA: "publishable" (sb_publishable_...) ou a antiga "anon".
# Nunca a "secret" / "service_role": essa ignora a RLS e não pode ficar no site.
VITE_SUPABASE_KEY=
